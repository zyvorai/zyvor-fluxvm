{
  "public_listen": "0.0.0.0:443",
  "tunnel_listen": "0.0.0.0:7444",
  "quic_tunnel_listen": "0.0.0.0:7444",
  "tls_cert": "/etc/fluxmesh-relay/server.pem",
  "tls_key": "/etc/fluxmesh-relay/server.key",
  "routes": [
    {
      "hostname": "*.example.net",
      "sites": ["home-primary", "office-peer"],
      "mode": "active-active"
    }
  ],
  "sites": [
    {
      "id": "home-primary",
      "secret_file": "/etc/fluxmesh-relay/home-primary.secret"
    },
    {
      "id": "office-peer",
      "secret_file": "/etc/fluxmesh-relay/office-peer.secret"
    }
  ]
}
