# /etc/fluxvm/bootstrap.conf: read by fluxvm-bootstrap (shell syntax).
MIRROR_URL=https://mirror.example.com/fluxvm
CHANNEL=stable
# Rollout rules in the channel file can require or exclude labels; list this node's here (space separated).
LABELS=""
# tarball | deb | rpm (default: tarball). Releases after 0.4.21 ship tarballs only; deb and rpm work only against a
# mirror built from a release that still carries those packages (0.4.21 or earlier).
#INSTALL_MODE=tarball
# 0 = fetch and verify and report, never install.
#FLUXVM_AUTO_UPGRADE=1
# The release public key: /etc/fluxvm/release.pub, or /usr/share/fluxvm/release.pub from a deb or rpm install.
