# /etc/fluxvm/agent.env, read by fluxvm-agent.service. The token goes in /etc/fluxvm/agent.token (0600), not here.
CENTRAL_URL=https://central.example.com:7799
NODE_NAME=change-me
# The address central reaches this node's fluxctl on; must not be empty or loopback.
ADVERTISE_URL=http://10.0.0.5:7788
