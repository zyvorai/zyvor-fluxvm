[Unit]
Description=FluxMesh public personal-cloud edge
After=network-online.target fluxmesh-agent.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/fluxmesh-edge run
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fluxvm/mesh
PrivateTmp=true

[Install]
WantedBy=multi-user.target
